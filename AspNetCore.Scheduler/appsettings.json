{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Hangfire": "Warning"
    }
  },
  "ConnectionStrings": {
    "HangfirePostgreSql": "Host=localhost;Port=5432;Database=AspNetCoreHangfireDb;Username=postgres;Password=123456;SSL Mode=Disable;"
  },
  "Hangfire": {
    "QueueName": "default",
    "WorkerCount": 4,
    "DashboardPath": "/hangfire",
    "DashboardAllowAnonymous": true,
    "AutoCreateDatabase": true,
    "AdminConnectionString": "Host=localhost;Port=5432;Database=postgres;Username=postgres;Password=123456;SSL Mode=Disable;"
  },
  "LoggingLib": {
    "ApplicationName": "Scheduler",
    "MinimumLevel": "Information",
    "Sinks": {
      "EnableConsole": true,
      "EnableFile": true,
      "EnableSeq": true,
      "SeqUrl": "http://localhost:5341",
      "FileBasePath": "logs",
      "FileRetainedFileCountLimit": 14,
      "FileSizeLimitBytes": 10485760
    },
    "Enrichment": {
      "EnableTraceId": true,
      "EnableUserContext": false,
      "EnableMachineName": true,
      "EnableThreadId": true
    }
  },
  "AllowedHosts": "*"
}
