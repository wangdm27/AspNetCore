{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "PrefetchCount": 10,
    "ChannelPoolSize": 16,
    "ConsumerChannelPoolSize": 16,
    "EnableDeadLetter": false,
    "DeadLetterExchange": "",
    "DeadLetterRoutingKey": "",
    "DeadLetterQueue": "",
    "MaxRetryCount": 5,
    "RetryBaseDelaySeconds": 5,
    "RetryMaxDelayMinutes": 5
  },
  "EventBus": {
    "ExchangePrefix": "evt.",
    "QueuePrefix": "q.",
    "ExchangeType": "direct"
  },
  "LoggingLib": {
    "ApplicationName": "EventDriven",
    "MinimumLevel": "Information",
    "Sinks": {
      "EnableConsole": true,
      "EnableFile": true,
      "EnableSeq": true,
      "SeqUrl": "http://localhost:5341",
      "FileBasePath": "logs",
      "FileRetainedFileCountLimit": 14,
      "FileSizeLimitBytes": 10485760
    },
    "Enrichment": {
      "EnableTraceId": true,
      "EnableUserContext": false,
      "EnableMachineName": true,
      "EnableThreadId": true
    }
  }
}
