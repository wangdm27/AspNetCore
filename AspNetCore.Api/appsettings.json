{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Database": {
    "Provider": "SqlServer",
    "Orm": "EntityFrameworkCore",
    "ConnectionStringName": "SqlServer",
    "CommandTimeoutSeconds": 30
  },
  "ConnectionStrings": {
    "SqlServer": "Server=localhost;Database=AspNetCoreDb;Trusted_Connection=True;TrustServerCertificate=True;",
    "PostgreSql": "Host=localhost;Port=5432;Database=AspNetCoreDb;Username=postgres;Password=123456;SSL Mode=Disable;"
  },
  "Jwt": {
    "Issuer": "AspNetCore.Api",
    "Audience": "AspNetCore.Client",
    "SigningKey": "AspNetCore-Replace-This-With-A-Strong-Key-1234567890",
    "AccessTokenExpiresMinutes": 120,
    "RefreshTokenExpiresDays": 7
  },
  "Email": {
    "SmtpHost": "localhost",
    "SmtpPort": 587,
    "UserName": "",
    "Password": "",
    "FromAddress": "noreply@example.com",
    "FromName": "AspNetCore App",
    "UseSsl": true,
    "PasswordResetUrl": "http://localhost:3000/reset-password?token={token}"
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "ChannelPoolSize": 16
  },
  "EventBus": {
    "ExchangePrefix": "evt.",
    "QueuePrefix": "q.",
    "ExchangeType": "direct"
  },
  "LoggingLib": {
    "ApplicationName": "Api",
    "MinimumLevel": "Information",
    "Sinks": {
      "EnableConsole": true,
      "EnableFile": true,
      "EnableSeq": true,
      "SeqUrl": "http://localhost:5341",
      "FileBasePath": "logs",
      "FileRetainedFileCountLimit": 14,
      "FileSizeLimitBytes": 10485760
    },
    "Enrichment": {
      "EnableTraceId": true,
      "EnableUserContext": true,
      "EnableMachineName": true,
      "EnableThreadId": true
    }
  },
  "AllowedHosts": "*"
}
