{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Database": {
    "Provider": "PostgreSql",
    "Orm": "EntityFrameworkCore",
    "ConnectionStringName": "PostgreSql",
    "CommandTimeoutSeconds": 30
